        { "unitId": "CSC211_U4", "title": "Graphs & Network Algorithms", "teachingHours": 9, "subtopics": ["BFS & DFS Traversals", "Prim's & Kruskal's MST", "Dijkstra's Shortest Path"] },
        { "unitId": "CSC211_U5", "title": "Sorting, Searching & Hashing", "teachingHours": 9, "subtopics": ["Quick Sort & Merge Sort", "Hash Tables", "Collision Resolution (Chaining vs Probing)"] }
      ]
    },
    {
      "code": "CSC260",
      "name": "Database Management Systems",
      "programId": "TU_CSIT",
      "semester": 4,
      "credits": 3,
      "difficulty": "Intermediate",
      "description": "Three-schema database architecture, ER modeling, relational algebra, advanced SQL, normalization up to BCNF, and ACID transaction recovery.",
      "learningOutcomes": [
        "Model business applications using Entity-Relationship (ER) diagrams.",
        "Write advanced SQL queries, joins, views, and triggers.",
        "Decompose relational schemas into 3NF and BCNF without data loss."
      ],
      "prerequisites": ["CSC211 Data Structures and Algorithms"],
      "syllabusUnits": [
        { "unitId": "CSC260_U1", "title": "Database Architecture & ER Modeling", "teachingHours": 6, "subtopics": ["Three-Schema Framework", "Physical vs Logical Independence", "ER & EER Modeling"] },
        { "unitId": "CSC260_U2", "title": "Relational Model & Relational Algebra", "teachingHours": 7, "subtopics": ["Integrity Constraints", "Select, Project, Join Operations", "Relational Calculus"] },
        { "unitId": "CSC260_U3", "title": "SQL Query Processing & Triggers", "teachingHours": 10, "subtopics": ["Complex Queries & Subqueries", "Views & Triggers", "Query Execution Plans"] },
        { "unitId": "CSC260_U4", "title": "Functional Dependencies & Normalization", "teachingHours": 9, "subtopics": ["Armstrong's Axioms", "1NF, 2NF, 3NF", "BCNF & Lossless Join Decompositions"] },
        { "unitId": "CSC260_U5", "title": "ACID Transactions & Concurrency", "teachingHours": 8, "subtopics": ["Serializability Schedules", "Two-Phase Locking (2PL)", "Write-Ahead Logging (WAL)"] }
      ]
    },
    {
      "code": "CSC261",
      "name": "Operating Systems",
      "programId": "TU_CSIT",
      "semester": 4,
      "credits": 3,
      "difficulty": "Intermediate",
      "description": "Kernel architecture, process synchronization, CPU scheduling, virtual memory paging, page replacement algorithms, and file systems.",
      "learningOutcomes": [
        "Understand process control blocks, context switches, and thread models.",
        "Prevent race conditions using mutex locks and counting semaphores.",
        "Analyze virtual memory performance and page replacement strategies."
      ],
      "prerequisites": ["CSC110 Introduction to Information Technology"],
      "syllabusUnits": [
        { "unitId": "CSC261_U1", "title": "OS Architecture & Process Model", "teachingHours": 6, "subtopics": ["Dual-Mode Operation", "Process Control Blocks (PCB)", "User vs Kernel Threads"] },
        { "unitId": "CSC261_U2", "title": "CPU Scheduling & Synchronization", "teachingHours": 10, "subtopics": ["Round Robin & Multilevel Queues", "Critical Section Problem", "Semaphores & Mutexes"] },
        { "unitId": "CSC261_U3", "title": "Deadlocks & Resource Allocation", "teachingHours": 6, "subtopics": ["Coffman Conditions", "Banker's Algorithm", "Deadlock Detection & Recovery"] },
        { "unitId": "CSC261_U4", "title": "Memory Management & Paging", "teachingHours": 10, "subtopics": ["Paging & TLB Translation", "Demand Paging & Page Faults", "FIFO, LRU, Optimal Replacement"] },
        { "unitId": "CSC261_U5", "title": "File Systems & Disk Scheduling", "teachingHours": 8, "subtopics": ["Inodes & Allocation Methods", "SCAN, C-SCAN Disk Scheduling", "RAID Configurations"] }
      ]
    },
