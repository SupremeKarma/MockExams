  "courses": [
    {
      "code": "CSC110",
      "name": "Introduction to Information Technology",
      "programId": "TU_CSIT",
      "semester": 1,
      "credits": 3,
      "difficulty": "Beginner",
      "description": "Computer hardware architecture, system software, networking protocols, databases, and digital information systems.",
      "learningOutcomes": [
        "Understand computer internal hardware architecture and bus structures.",
        "Comprehend base numbering systems, 2's complement, and logic gate conversions.",
        "Explain operating system fundamentals and memory management models."
      ],
      "prerequisites": ["None (Foundational)"],
      "syllabusUnits": [
        { "unitId": "CSC110_U1", "title": "Computer Fundamentals & Architecture", "teachingHours": 6, "subtopics": ["Von Neumann Architecture", "CPU, ALU, Registers & Bus Structures", "Storage Technologies"] },
        { "unitId": "CSC110_U2", "title": "Number Systems & Digital Logic", "teachingHours": 6, "subtopics": ["Binary, Hexadecimal Arithmetic", "2's Complement", "Boolean Logic Gates"] },
        { "unitId": "CSC110_U3", "title": "System & Application Software", "teachingHours": 8, "subtopics": ["Operating Systems", "Compilers vs Interpreters", "Process Scheduling"] },
        { "unitId": "CSC110_U4", "title": "Networking & Internet Protocols", "teachingHours": 8, "subtopics": ["OSI vs TCP/IP Models", "Network Topologies", "DNS & HTTP/HTTPS Protocols"] },
        { "unitId": "CSC110_U5", "title": "Information Security & Cloud", "teachingHours": 7, "subtopics": ["Malware Types", "Basic Cryptography", "Cloud & IoT Fundamentals"] }
      ]
    },
    {
      "code": "CSC111",
      "name": "C Programming",
      "programId": "TU_CSIT",
      "semester": 1,
      "credits": 3,
      "difficulty": "Beginner",
      "description": "Structured procedural programming in C covering data types, control flow, functions, arrays, pointers, dynamic memory allocation, and file I/O.",
      "learningOutcomes": [
        "Design structured procedural algorithms in C.",
        "Master pointer arithmetic and heap memory management (malloc, free).",
        "Work with file handling and complex user-defined structures."
      ],
      "prerequisites": ["CSC110 Introduction to Information Technology"],
      "syllabusUnits": [
        { "unitId": "CSC111_U1", "title": "Elements of C & Control Flow", "teachingHours": 8, "subtopics": ["Variables & Data Types", "Operator Precedence", "if-else & switch-case", "Loops (for, while)"] },
        { "unitId": "CSC111_U2", "title": "Functions & Storage Classes", "teachingHours": 6, "subtopics": ["Prototypes & Call by Reference", "Recursion & Stack Frames", "Storage Classes (static, extern)"] },
        { "unitId": "CSC111_U3", "title": "Arrays & Strings", "teachingHours": 7, "subtopics": ["Multi-dimensional Arrays", "Matrix Operations", "String Manipulation Without Library"] },
        { "unitId": "CSC111_U4", "title": "Pointers & Dynamic Memory", "teachingHours": 9, "subtopics": ["Pointer Dereferencing", "Pointers to Pointers", "malloc(), calloc(), free()"] },
        { "unitId": "CSC111_U5", "title": "Structures & File I/O", "teachingHours": 8, "subtopics": ["Nested Structures", "Unions", "File Reading and Writing (fopen, fread, fwrite)"] }
      ]
    },
    {
