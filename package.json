{
  "name": "mockexams",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed-firebase": "dotenv -e .env.local ts-node -r tsconfig-paths/register supabase/seed-firestore.ts",
    "import-bulk-exams": "node supabase/import-bulk-exams.mjs",
    "test": "vitest run --exclude tests/firestore-rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project mockexams-rules-test \"vitest run tests/firestore-rules.test.ts\"",
    "author-notes": "dotenv -e .env.local -- tsx scripts/author-notes.ts",
    "author-rubrics": "dotenv -e .env.local -- tsx scripts/author-rubrics.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@uiw/react-md-editor": "^4.1.0",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.37.0",
    "ioredis": "^6.0.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-katex": "^3.1.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-katex": "^3.0.4",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.19.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-tools": "^13.35.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
