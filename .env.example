# --- Firebase Client Configuration (Public) -----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mockexams-f5bfa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://mockexams-f5bfa-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mockexams-f5bfa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mockexams-f5bfa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Admin SDK (Server-Side Only) ------------------------------------
# Service account credentials for privileged Firestore & Auth operations
FIREBASE_PROJECT_ID=mockexams-f5bfa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mockexams-f5bfa.iam.gserviceaccount.com
# Format private key with escaped newlines: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC5...\n-----END PRIVATE KEY-----\n"

# --- Application Base URL ----------------------------------------------------
NEXT_PUBLIC_APP_URL=https://mockexams.com.np

# --- Google Gemini API (AI Tutor, Rubrics, Written Answer Grading) -----------
# Get free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- Stripe Payments (International) -----------------------------------------
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# --- Nepal Payment Gateways (Local Currencies) --------------------------------
# eSewa:
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_ENV=test
# Khalti:
KHALTI_SECRET_KEY=key_test_secret_...
KHALTI_ENV=test

# --- ExamAI PostgreSQL Engine (Syllabus, Ingestion & Grounded Search) ---------
# Reader: Read-only role connecting to published schema
EXAMAI_READER_DATABASE_URL=postgresql://reader_role:password@localhost:5432/examai?sslmode=require
# Writer: Ingestion pipeline & extraction worker role
EXAMAI_WRITER_DATABASE_URL=postgresql://writer_role:password@localhost:5432/examai?sslmode=require
