# Backups of env files. The rule above (.env*.local) only matches names
# ENDING in .local, so ".env.local.bak.1787312003" slipped through and was
# staged with a real FIREBASE_PRIVATE_KEY and GEMINI_API_KEY in it.
.env*.bak*
.env.*.bak*
*.env.bak
