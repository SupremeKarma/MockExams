# Firebase Configuration (Client-side - REQUIRED)
# Get these from: Firebase Console > Project Settings > Your apps > SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (Server-side - REQUIRED for exam submission/grading)
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCA...\n-----END PRIVATE KEY-----\n"

# Stripe Configuration (Optional)
# Get these from: https://dashboard.stripe.com/apikeys

# --- Payments -------------------------------------------------------------
# eSewa is the primary rail: Stripe does not onboard merchants in Nepal.
# Leave ESEWA_SECRET_KEY unset to fall back to Stripe (international/campus).
# Sandbox credentials: https://developer.esewa.com.np
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_ENV=test

# Khalti (the other common Nepali rail). Sandbox runs against dev.khalti.com;
# set KHALTI_ENV=live and swap in your live secret key to go to production.
# Sandbox key + test credentials: https://docs.khalti.com/testing/
# Khalti's published sandbox key; payment runs on test-pay.khalti.com.
KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455
KHALTI_ENV=test

# Going live: set ESEWA_ENV=live and KHALTI_ENV=live with your merchant keys.
# A production build that is still on the test endpoints refuses to start
# checkout — otherwise real users would pay on the provider's test page and be
# granted access with no money moving. Set ALLOW_TEST_PAYMENTS_IN_PROD=true
# only for a staging environment that runs a production build on purpose.

# Stripe (optional - international and campus deals only).
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Real price ids from the Stripe dashboard; the app no longer accepts a
# price id from the client.
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_CAMPUS_SEMESTER=price_xxx

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini API (Required for the AI Socratic Tutor, written-answer exam
# grading, and document/photo question extraction)
# Get a free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to gemini-2.0-flash-lite, the cheapest tier and the one
# with the most generous free quota. Raise it only if grading quality needs it.
# GEMINI_MODEL=gemini-2.5-flash

# Supreme AI gateway (optional). When set, the AI Tutor routes through the
# Supreme AI platform's /ask endpoint instead of calling Gemini directly —
# MockExams is a thin client here, scope is always "examai" and is not
# configurable (see src/lib/supremeAsk.ts). Falls back to direct Gemini above
# if unset, or if the gateway call itself fails.
# SUPREME_GATEWAY_URL=http://localhost:8000
# SUPREME_GATEWAY_API_KEY=sk-supreme-...

# Only needed to run `npm run ingest-knowledge` (scripts/ingest-knowledge.mjs),
# which loads solutions/*.md into the platform's shared knowledge collection
# under scope "examai" so /ask's `sources` can cite them. Points directly at
# memory-service (not the gateway) — same INTERNAL_API_KEY value configured
# in the SUPREME-AI repo's .env.local.
# MEMORY_SERVICE_URL=http://localhost:8020
# INTERNAL_API_KEY=...
